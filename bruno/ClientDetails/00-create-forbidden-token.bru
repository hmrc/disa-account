meta {
  name: Create local forbidden token
  type: http
  seq: 1
}

post {
  url: {{internalAuthUrl}}/test-only/token
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "{{forbiddenToken}}",
    "principal": "disa-account-local-forbidden-client",
    "permissions": []
  }
}
