meta {
  name: 16-403-missing-identifier
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/disa-account/client-details/business-tax-account/Z1234
  body: none
  auth: none
}

headers {
  Authorization: {{btaAuthorisation}}
}

assert {
  res.status: 403
  res.body.code: DISA_ENROLMENT_NOT_FOUND
  res.body.message: An active DISA enrolment matching the requested Z-Reference is required
}
