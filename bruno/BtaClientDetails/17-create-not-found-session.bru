meta {
  name: 17-create-not-found-session
  type: http
  seq: 17
}

post {
  url: {{authLoginBaseUrl}}/government-gateway/session/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "credId": "{{btaCredId}}",
    "affinityGroup": "Organisation",
    "credentialStrength": "strong",
    "credentialRole": "admin",
    "enrolments": [
      {
        "key": "HMRC-DISA-ORG",
        "identifiers": [
          {
            "key": "ZREF",
            "value": "Z0404"
          }
        ],
        "state": "Activated"
      }
    ]
  }
}

script:pre-request {
  bru.setVar("btaCredId", String(Date.now()) + String(Math.floor(Math.random() * 1000)).padStart(3, "0"));
}

script:post-response {
  const authorisation = res.getHeader("authorization");
  if (!authorisation) {
    throw new Error("auth-login-api did not return an Authorization header");
  }
  bru.setVar("btaAuthorisation", authorisation);
}

assert {
  res.status: 201
}
