meta {
  name: 05-401-invalid-credentials
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/disa-account/client-details/business-tax-account/Z1234
  body: none
  auth: none
}

headers {
  Authorization: Bearer invalid-bta-token
}

assert {
  res.status: 401
  res.body.code: UNAUTHORIZED
  res.body.message: Authentication is required
}
