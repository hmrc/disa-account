meta {
  name: 02-204-put
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/disa-account/agents/preferences
  body: json
  auth: none
}

headers {
  Authorization: {{agentAuthorisation}}
  Content-Type: application/json
}

body:json {
  {
    "zReference": "{{zReference}}"
  }
}

assert {
  res.status: 204
}
