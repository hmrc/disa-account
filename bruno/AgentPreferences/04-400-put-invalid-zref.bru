meta {
  name: 04-400-put-invalid-zref
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/disa-account/agents/preferences
  body: json
  auth: none
}

headers {
  Authorization: {{agentAuthorisation}}
  Content-Type: application/json
}

body:json {
  {
    "zReference": "z1234"
  }
}

assert {
  res.status: 400
  res.body.code: INVALID_ZREFERENCE_FORMAT
}
