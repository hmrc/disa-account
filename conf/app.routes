# microservice specific routes

GET     /registration/:zref    uk.gov.hmrc.disaaccount.controllers.RegistrationController.retrieveRegistrationDetails(zref: String)
PUT     /registration/:zref    uk.gov.hmrc.disaaccount.controllers.RegistrationController.updateRegistrationDetails(zref: String)

GET     /client-details/:zref  uk.gov.hmrc.disaaccount.controllers.ClientDetailsController.get(zref: String)
